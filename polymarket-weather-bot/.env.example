# ─────────────────────────────────────────────────────────────
# Telegram Bot Configuration
# ─────────────────────────────────────────────────────────────
# Get your bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Optional: Admin chat ID for error notifications & bot status
ADMIN_CHAT_ID=

# ─────────────────────────────────────────────────────────────
# Polymarket API Configuration (no auth needed for public data)
# ─────────────────────────────────────────────────────────────
GAMMA_API_BASE_URL=https://gamma-api.polymarket.com
CLOB_API_BASE_URL=https://clob.polymarket.com

# ─────────────────────────────────────────────────────────────
# Trading Configuration (OPTIONAL - leave empty to disable)
# ─────────────────────────────────────────────────────────────
# WARNING: Trading uses REAL FUNDS. Only set these if you understand the risks.

# Your Polygon wallet private key (hex, starts with 0x)
# NEVER share this key. NEVER commit it to version control.
PRIVATE_KEY=

# Funder/deposit wallet address (where your pUSD is held)
# For EOA (type 0): same as your wallet address
# For deposit wallet (type 3): your deposit wallet address
FUNDER_ADDRESS=

# Signature type for order signing:
# 0 = EOA (standard wallet, you pay gas)
# 1 = POLY_PROXY (existing Polymarket proxy wallet)
# 2 = GNOSIS_SAFE (existing Gnosis Safe wallet)
# 3 = POLY_1271 (deposit wallet - recommended for new API users)
SIGNATURE_TYPE=0

# Polygon RPC URL (for transaction signing)
POLYGON_RPC_URL=https://polygon-rpc.com

# Strategy monitoring interval (how often to check auto-trade conditions, in seconds)
STRATEGY_CHECK_SECONDS=30

# Safety limits
MAX_POSITION_SIZE=1000
MAX_TOTAL_EXPOSURE=5000

# ─────────────────────────────────────────────────────────────
# Bot Configuration
# ─────────────────────────────────────────────────────────────
CACHE_TTL_SECONDS=60
MAX_MARKETS_PER_PAGE=10
POLLING_INTERVAL_MINUTES=5

# ─────────────────────────────────────────────────────────────
# Logging
# ─────────────────────────────────────────────────────────────
LOG_LEVEL=info
